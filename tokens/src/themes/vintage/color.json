{
  "$description": "Tier 2 color roles for Vintage, the Triple Feature identity. Every theme in tokens/themes/ defines these same names; only the values differ.",
  "theme": {
    "color": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{palette.ink.default}",
          "$description": "Page background."
        },
        "raised": {
          "$type": "color",
          "$value": "{palette.ink.raised}",
          "$description": "Cards, fields and popovers above the page."
        },
        "overlay": {
          "$type": "color",
          "$value": "{palette.ink.overlay}",
          "$description": "Hovered and focused rows inside raised surfaces (menus, suggestions), skeleton bars"
        }
      },
      "content": {
        "default": {
          "$type": "color",
          "$value": "{palette.bone.default}",
          "$description": "Body text and icons.",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.background.default",
                "theme.color.background.raised",
                "theme.color.background.overlay"
              ],
              "min": 4.5
            }
          }
        },
        "soft": {
          "$type": "color",
          "$value": "{palette.bone.soft}",
          "$description": "Body and lede text",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default", "theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.dust}",
          "$description": "Secondary text and metadata",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.background.default",
                "theme.color.background.raised",
                "theme.color.background.overlay"
              ],
              "min": 4.5
            }
          }
        },
        "placeholder": {
          "$type": "color",
          "$value": "{palette.dust}",
          "$description": "Placeholder text in fields.",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "danger": {
          "$type": "color",
          "$value": "{palette.red.300}",
          "$description": "Error text (field errors). Blood is too dark for small text",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default", "theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "accent": {
          "$type": "color",
          "$value": "{palette.mustard.default}",
          "$description": "Accent-colored text and icons on the page: links, active tabs, the selected count.",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default", "theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "highlight": {
          "$type": "color",
          "$value": "{palette.blood}",
          "$description": "Highlight-colored marks and large headline words. Large text and marks only (3:1).",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default"],
              "min": 3
            }
          }
        }
      },
      "accent": {
        "content": {
          "$type": "color",
          "$value": "{palette.ink.default}",
          "$description": "Text on mustard fills",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.accent.background",
                "theme.color.accent.background-hover",
                "component.button.primary.background-hover",
                "theme.signal.tag.watchlist",
                "theme.signal.tag.liked",
                "theme.signal.tag.disliked"
              ],
              "min": 4.5
            }
          }
        },
        "background": {
          "$type": "color",
          "$value": "{palette.mustard.default}",
          "$description": "Labels, links, focus, utility buttons"
        },
        "background-hover": {
          "$type": "color",
          "$value": "{palette.mustard.hover}",
          "$description": "Accent fills on hover and press.",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default"],
              "min": 4.5
            }
          }
        }
      },
      "highlight": {
        "content": {
          "$type": "color",
          "$value": "{palette.bone.default}",
          "$description": "Text on highlight fills (CTAs, the match stamp)",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.highlight.background"],
              "min": 4.5
            }
          }
        },
        "background": {
          "$type": "color",
          "$value": "{palette.blood}",
          "$description": "The brand's second accent: CTA fills, the match stamp and large headline words. In Vintage it's blood red, about 3:1 on ink, so never small text"
        }
      },
      "border": {
        "accent": {
          "$type": "color",
          "$value": "{palette.mustard.default}",
          "$description": "Accent outlines: selected cards, active fields, the shelf rule."
        },
        "danger": {
          "$type": "color",
          "$value": "{palette.blood}",
          "$description": "Error borders and error marks (3:1 on the page). Error text uses fg.danger",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default"],
              "min": 3
            }
          }
        },
        "default": {
          "$type": "color",
          "$value": "{palette.line.default}",

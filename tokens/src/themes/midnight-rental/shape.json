{
  "$description": "Shape and elevation roles for Midnight Rental.",
  "theme": {
    "border": {
      "control": {
        "radius": {
          "$type": "dimension",
          "$value": {
            "value": 10,
            "unit": "px"
          }
        }
      },
      "container": {
        "radius": {
          "$type": "dimension",
          "$value": {
            "value": 16,
            "unit": "px"
          }
        }
      }
    },
    "shadow": {
      "stamp": {
        "$type": "shadow",
        "$value": {
          "color": "{palette.glow-cyan}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 8,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "cta": {
        "$type": "shadow",
        "$value": {
          "color": "{palette.glow}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 16,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "box": {
        "$type": "shadow",
        "$value": {
          "color": "{palette.glow}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 24,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    },
    "size": {
      "headline-shadow-offset": {
        "$type": "dimension",
        "$value": {
          "value": 3,
          "unit": "px"
        }
      }
    }
  }
}

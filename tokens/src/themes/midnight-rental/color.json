            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default", "theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "highlight": {
          "$type": "color",
          "$value": "{palette.cyan}",
          "$description": "Highlight-colored marks and large headline words. Large text and marks only (3:1).",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default"],
              "min": 3
            }
          }
        }
      },
      "accent": {
        "content": {
          "$type": "color",
          "$value": "{palette.night}",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.accent.background",
                "theme.color.accent.background-hover",
                "component.button.primary.background-hover",
                "theme.signal.tag.watchlist",
                "theme.signal.tag.liked",
                "theme.signal.tag.disliked"

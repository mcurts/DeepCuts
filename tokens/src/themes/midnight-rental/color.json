{
  "$description": "Tier 2 color roles for Midnight Rental: the same names as every theme, this brand's values.",
  "theme": {
    "color": {
      "background": {
        "default": {
          "$type": "color",
          "$value": "{palette.night}",
          "$description": "Page background."
        },
        "raised": {
          "$type": "color",
          "$value": "{palette.night-raised}",
          "$description": "Cards, fields and popovers above the page."
        },
        "overlay": {
          "$type": "color",
          "$value": "{palette.night-overlay}"
        }
      },
      "content": {
        "default": {
          "$type": "color",
          "$value": "{palette.haze}",
          "$description": "Body text and icons.",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.background.default",
                "theme.color.background.raised",
                "theme.color.background.overlay"
              ],
              "min": 4.5
            }
          }
        },
        "soft": {
          "$type": "color",
          "$value": "{palette.haze-soft}",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": ["theme.color.background.default", "theme.color.background.raised"],
              "min": 4.5
            }
          }
        },
        "muted": {
          "$type": "color",
          "$value": "{palette.lilac}",
          "$extensions": {
            "com.mikecurts.contrast": {
              "on": [
                "theme.color.background.default",
                "theme.color.background.raised",
                "theme.color.background.overlay"

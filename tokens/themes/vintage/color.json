{
  "$description": "Tier 2 color roles for Vintage, the Triple Feature identity (ADR-0040). Every theme in tokens/themes/ defines these same names (ADR-0056); only the values differ.",
  "color": {
    "$type": "color",
    "surface": {
      "default": {
        "$value": "{palette.ink.default}"
      },
      "raised": {
        "$value": "{palette.ink.raised}"
      },
      "overlay": {
        "$value": "{palette.ink.overlay}",
        "$description": "Hovered and focused rows inside raised surfaces (menus, suggestions), skeleton bars"
      }
    },
    "fg": {
      "default": {
        "$value": "{palette.bone.default}"
      },
      "soft": {
        "$value": "{palette.bone.soft}",
        "$description": "Body and lede text"
      },
      "muted": {
        "$value": "{palette.dust}",
        "$description": "Secondary text and metadata"
      },
      "placeholder": {
        "$value": "{palette.dust}"
      },
      "on-accent": {
        "$value": "{palette.ink.default}",
        "$description": "Text on mustard fills"
      },
      "on-highlight": {
        "$value": "{palette.bone.default}",
        "$description": "Text on highlight fills (CTAs, the match stamp)"
      },
      "danger": {
        "$value": "{palette.red.300}",
        "$description": "Error text (field errors). Blood is too dark for small text"
      }
    },
    "accent": {
      "default": {
        "$value": "{palette.mustard.default}",
        "$description": "Labels, links, focus, utility buttons"
      },
      "hover": {
        "$value": "{palette.mustard.hover}"
      }
    },
    "highlight": {
      "$value": "{palette.blood}",
      "$description": "The brand's second accent: CTA fills, the match stamp and large headline words. In Vintage it's blood red, about 3:1 on ink, so never small text (ADR-0040)"
    },
    "danger": {
      "$value": "{palette.blood}",
      "$description": "Error borders and error marks (3:1 on the page). Error text uses fg.danger"
    },
    "contextual": {
      "$value": "{color.accent.default}",
      "$description": "The page accent (ADR-0020). Defaults to the brand accent; a tag-filtered list sets it to that tag's color."
    },
    "border": {
      "default": {
        "$value": "{palette.line.default}",
        "$description": "Structure lines and dividers (decorative)"
      },
      "strong": {
        "$value": "{palette.line.strong}",
        "$description": "Dashed outlines of empty slots (decorative)"
      },
      "control": {
        "$value": "{palette.dust}",
        "$description": "Outlines that identify a control (3:1)"
      },
      "emphasis": {
        "$value": "{palette.bone.default}",
        "$description": "2-3px bone outlines on fields, buttons and the stamp ring"
      }
    },
    "focus": {
      "$value": "{palette.mustard.default}"
    },
    "favourite": {
      "$value": "{palette.mustard.default}",
      "$description": "Favourite films: the Top Ten (ADR-0035). Decorative; always next to its label"
    },
    "match": {
      "$description": "The match sticker's fill and text, in five steps from red to neon green by the pick's match (owner, 2026-10-13). Each step's text passes 4.5:1 on its fill (scripts/contrast-pairs.json); the match is always written on the sticker too.",
      "0": {
        "default": {
          "$value": "{palette.blood}",
          "$description": "0–19%"
        },
        "fg": {
          "$value": "{color.fg.on-highlight}"
        }
      },
      "20": {
        "default": {
          "$value": "{palette.heat.20}",
          "$description": "20–39%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "40": {
        "default": {
          "$value": "{palette.heat.40}",
          "$description": "40–59%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "60": {
        "default": {
          "$value": "{palette.heat.60}",
          "$description": "60–79%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "80": {
        "default": {
          "$value": "{palette.heat.80}",
          "$description": "80–100%"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      }
    },
    "shadow": {
      "$value": "{palette.black}",
      "$description": "Hard offset shadows (ADR-0040)"
    },
    "tag": {
      "watchlist": {
        "$value": "{color.sky.300}",
        "$description": "Want to see"
      },
      "liked": {
        "$value": "{palette.bone.default}",
        "$description": "Like"
      },
      "disliked": {
        "$value": "{palette.red.300}",
        "$description": "Dislike. The only red in the UI (ADR-0020)"
      }
    },
    "genre": {
      "$description": "Card tones per TMDB genre (design v2). Decorative; always paired with the genre name as text.",
      "default": {
        "$value": "{palette.dust}"
      },
      "action": {
        "$value": "{color.orange.500}"
      },
      "adventure": {
        "$value": "{color.lime.500}"
      },
      "animation": {
        "$value": "{color.gold.500}"
      },
      "comedy": {
        "$value": "{color.gold.500}"
      },
      "crime": {
        "$value": "{color.indigo.600}"
      },
      "documentary": {
        "$value": "{color.green.600}"
      },
      "drama": {
        "$value": "{color.sky.500}"
      },
      "family": {
        "$value": "{color.lime.500}"
      },
      "fantasy": {
        "$value": "{color.violet.600}"
      },
      "history": {
        "$value": "{color.green.600}"
      },
      "horror": {
        "$value": "{color.violet.600}"
      },
      "music": {
        "$value": "{color.magenta.600}"
      },
      "mystery": {
        "$value": "{color.indigo.600}"
      },
      "romance": {
        "$value": "{color.magenta.600}"
      },
      "science-fiction": {
        "$value": "{color.cyan.500}"
      },
      "thriller": {
        "$value": "{color.orange.500}"
      },
      "tv-movie": {
        "$value": "{color.sky.500}"
      },
      "war": {
        "$value": "{color.orange.500}"
      },
      "western": {
        "$value": "{color.gold.500}"
      }
    },
    "print": {
      "paper": {
        "$value": "{palette.bone.default}",
        "$description": "Printed-matter paper: stickers and labels drawn as physical objects"
      },
      "ink": {
        "$value": "{palette.ink.default}",
        "$description": "Ink printed on that paper"
      },
      "spot": {
        "$value": "{palette.mustard.default}",
        "$description": "A printed card in the brand's spot ink, with print.ink on it: the Top Ten sticker before the film is added"
      }
    }
  }
}

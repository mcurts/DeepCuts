{
  "$description": "Tier 3: text fields (the search field, with its flush action button) and their suggestion popover.",
  "color": {
    "$type": "color",
    "field": {
      "bg": {
        "$value": "{color.surface.raised}"
      },
      "border": {
        "$value": "{color.border.emphasis}"
      },
      "border-focus": {
        "$value": "{color.focus}"
      },
      "action-bg": {
        "$value": "{color.fg.default}",
        "$description": "The bone FIND button flush with the field (ADR-0040)"
      },
      "action-fg": {
        "$value": "{color.fg.on-accent}"
      }
    },
    "popover": {
      "bg": {
        "$value": "{color.surface.raised}"
      },
      "border": {
        "$value": "{color.border.emphasis}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "popover": {
      "$value": "{elevation.box}"
    }
  },
  "radius": {
    "$type": "dimension",
    "field": {
      "$value": "{radius.control}"
    },
    "popover": {
      "$value": "{radius.container}"
    }
  }
}

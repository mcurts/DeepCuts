{
  "$description": "Tier 3: buttons (ADR-0040). Primary is a mustard utility button; CTA is the one blood-red call to action on a page; secondary is a bone outline.",
  "color": {
    "$type": "color",
    "button": {
      "primary": {
        "bg": {
          "$value": "{color.accent.default}"
        },
        "bg-hover": {
          "$value": "{color.accent.hover}"
        },
        "fg": {
          "$value": "{color.fg.on-accent}"
        }
      },
      "cta": {
        "bg": {
          "$value": "{color.highlight}"
        },
        "fg": {
          "$value": "{color.fg.on-highlight}"
        }
      },
      "secondary": {
        "bg": {
          "$value": "{color.surface.default}"
        },
        "fg": {
          "$value": "{color.fg.default}"
        },
        "border": {
          "$value": "{color.border.emphasis}"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "button-cta": {
      "$value": "{elevation.cta}"
    }
  },
  "radius": {
    "$type": "dimension",
    "button": {
      "$value": "{radius.control}"
    }
  }
}

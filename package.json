{
  "name": "deep-cuts",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "tokens": "node sd.config.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build && node scripts/generate-headers.mjs",
    "preview": "vite preview",
    "preview:cf": "node scripts/preview-cf.mjs",
    "preview:accounts": "VITE_ACCOUNTS=cloudflare npm run build && npm run db:migrate:local && npm run preview:cf",
    "deploy": "node scripts/deploy.mjs",
    "version:next": "node scripts/version-next.mjs",
    "db:migrate:local": "wrangler d1 migrations apply deep-cuts --local",
    "invite": "node scripts/invite.mjs",
    "analyze": "npm run tokens && vite build --mode analyze",
    "typecheck": "npm run tokens && tsc -b",
    "lint": "eslint . --max-warnings=0 && node scripts/check-raw-colors.mjs && node scripts/check-token-tiers.mjs && node scripts/check-env.mjs && node scripts/check-retired-session.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run tokens",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "npm run tokens && vitest run --coverage",
    "check:contrast": "npm run tokens && node scripts/check-contrast.mjs",
    "check:dist": "node scripts/check-dist-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:contrast && npm run coverage && npm run build && npm run check:dist && npm run check:bundle",
    "preformat": "npm run tokens",
    "preformat:check": "npm run tokens",
    "e2e": "playwright test",
    "e2e:cf": "playwright test --config playwright.cf.config.ts",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build --quiet",
    "storybook:test": "playwright test --config playwright.storybook.config.ts",
    "tokens:ramps": "node scripts/generate-ramps.mjs && npm run tokens",
    "icons": "npm run tokens && node scripts/generate-icons.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.6.3",
    "style-dictionary": "5.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  }
}

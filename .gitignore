# Files git should never track.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
DEEPCUTS.code-workspace
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets (ADR-0008)
.env
.env.*
!.env.example
# Local secrets for `wrangler pages dev` (ADR-0029)
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler's local state (local D1, cache, logs)
.wrangler

# Generated by the build, tests or `npm run tokens` (rebuilt on demand, so never committed)
coverage
build
src/styles/tokens.css
test-results
playwright-report
src/styles/theme.css
src/styles/themes/
src/styles/themes.css
src/styles/themes.ts
src/styles/theme-fonts.css
public/theme-boot.js
storybook-static
*storybook.log

# Local agent setup: CLAUDE.md just loads AGENTS.md for Claude Code, and .claude/ holds personal
# settings. Decision records and their tooling live in the separate docs repo.
CLAUDE.md
.claude/
